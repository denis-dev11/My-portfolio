eval("{__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   \"default\": () => (__WEBPACK_DEFAULT_EXPORT__)\n/* harmony export */ });\n/* harmony import */ var _node_modules_css_loader_dist_runtime_noSourceMaps_js__WEBPACK_IMPORTED_MODULE_0__ = __webpack_require__(/*! ../node_modules/css-loader/dist/runtime/noSourceMaps.js */ \"./node_modules/css-loader/dist/runtime/noSourceMaps.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_noSourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_noSourceMaps_js__WEBPACK_IMPORTED_MODULE_0__);\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__ = __webpack_require__(/*! ../node_modules/css-loader/dist/runtime/api.js */ \"./node_modules/css-loader/dist/runtime/api.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__);\n/* harmony import */ var _node_modules_css_loader_dist_runtime_getUrl_js__WEBPACK_IMPORTED_MODULE_2__ = __webpack_require__(/*! ../node_modules/css-loader/dist/runtime/getUrl.js */ \"./node_modules/css-loader/dist/runtime/getUrl.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_getUrl_js__WEBPACK_IMPORTED_MODULE_2___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_getUrl_js__WEBPACK_IMPORTED_MODULE_2__);\n// Imports\n\n\n\nvar ___CSS_LOADER_URL_IMPORT_0___ = new URL(/* asset import */ __webpack_require__(/*! ../assets/creative-desktop-wallpaper_941097-67554.avif */ \"./assets/creative-desktop-wallpaper_941097-67554.avif\"), __webpack_require__.b);\nvar ___CSS_LOADER_EXPORT___ = _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default()((_node_modules_css_loader_dist_runtime_noSourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default()));\nvar ___CSS_LOADER_URL_REPLACEMENT_0___ = _node_modules_css_loader_dist_runtime_getUrl_js__WEBPACK_IMPORTED_MODULE_2___default()(___CSS_LOADER_URL_IMPORT_0___);\n// Module\n___CSS_LOADER_EXPORT___.push([module.id, `* {\r\n  margin: 0;\r\n  padding: 0;\r\n  box-sizing: border-box;\r\n  font-family: Arial, sans-serif;\r\n}\r\n\r\nhtml, body {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n/* NAVIGATION */\r\nnav {\r\n  background-color: rgba(20, 20, 76, 0.185);\r\n  display: flex;\r\n  justify-content: space-between; /* separates left and right */\r\n  align-items: center;\r\n  width: 100%;\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  padding: 20px 40px;\r\n  z-index: 10;\r\n  color: white;\r\n}\r\n\r\n/* LEFT LINKS */\r\n.nav-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 30px;\r\n}\r\n\r\n/* Logo */\r\n.logo {\r\n  text-decoration: none;      \r\n  color: white;               \r\n  font-size: 20px;            \r\n  font-weight: 700;           \r\n  letter-spacing: 1px;        \r\n}\r\n\r\n.logo:hover {\r\n  color: #00eaff;\r\n  transition: color 0.5s ease;\r\n}\r\n\r\n/* NAV LINKS (desktop) */\r\nnav ul {\r\n  display: flex;\r\n  gap: 30px;\r\n}\r\n\r\nnav ul li {\r\n  list-style: none;\r\n}\r\n\r\nnav ul li a {\r\n  text-decoration: none;\r\n  color: white;\r\n  font-size: 16px;\r\n}\r\n\r\n/* NAV LINK EFFECT (same feel as buttons) */\r\nnav ul li a,\r\n.nav-links a {\r\n  position: relative;\r\n  transition: color 0.3s ease, transform 0.2s ease;\r\n}\r\n\r\nnav ul li a::after,\r\n.nav-links a::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  left: 50%;\r\n  bottom: -6px;\r\n  width: 0;\r\n  height: 2px;\r\n  background: #00eaff;\r\n  transition: width 0.3s ease, left 0.3s ease;\r\n}\r\n\r\nnav ul li a:hover,\r\n.nav-links a:hover {\r\n  color: #00eaff;\r\n  transform: translateY(-2px);\r\n}\r\n\r\nnav ul li a:hover::after,\r\n.nav-links a:hover::after {\r\n  width: 100%;\r\n  left: 0;\r\n}\r\n\r\n\r\n/* HAMBURGER */\r\n.hamburger {\r\n  display: none;\r\n  width: 30px;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  cursor: pointer;\r\n}\r\n\r\n.hamburger span {\r\n  width: 100%;\r\n  height: 3px;\r\n  background: white;\r\n}\r\n\r\n.mobile-active {\r\n  display: flex !important;\r\n}\r\n\r\n/* CLOSE BUTTON */\r\n.close-btn {\r\n  display: none; \r\n  transition: opacity 0.3s ease, transform 0.3s ease;\r\n  opacity: 0;\r\n  transform: rotate(-20deg);\r\n}\r\n\r\n.nav-links.mobile-active .close-btn {\r\n  display: block; \r\n  opacity: 1;\r\n  transform: rotate(0deg);\r\n}\r\n\r\n/* HERO SECTION */\r\n.hero {\r\n  width: 100%;\r\n  height: 100vh; /* let it shrink */\r\n  min-height: 60vh; /* optional: avoid it getting too small */\r\n  background: url(${___CSS_LOADER_URL_REPLACEMENT_0___}) center center/cover no-repeat;\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 60px;\r\n  color: white;\r\n}\r\n\r\n\r\n\r\n.hero::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  background: rgba(0,0,0,0.55);\r\n}\r\n\r\n.content {\r\n  position: relative;\r\n  z-index: 5;\r\n  max-width: 450px;\r\n}\r\n\r\n.content h1 {\r\n  font-size: 48px;\r\n  font-weight: 700;\r\n  width: 100%;\r\n}\r\n\r\n.content h1 span {\r\n  color: #00eaff;\r\n}\r\n\r\n.content h3 {\r\n  margin: 12px 0 25px;\r\n  font-size: 20px;\r\n  font-weight: 300;\r\n  letter-spacing: 0.8em;\r\n}\r\n\r\n.buttons {\r\n  display: flex;\r\n  gap: 15px;\r\n}\r\n\r\n.buttons a {\r\n  padding: 10px 25px;\r\n  border: 2px solid #00eaff;\r\n  border-radius: 25px;\r\n  color: #00eaff;\r\n  text-decoration: none;\r\n  transition: background 0.3s ease, color 0.3s ease, transform 0.2s ease;\r\n}\r\n\r\n.buttons a:hover {\r\n  background: #00eaff;\r\n  color: #000;\r\n  transform: translateY(-3px);\r\n}\r\n\r\n\r\n/* SOCIAL LINKS AT THE BOTTOM */\r\n\r\n.socials {\r\n  position: absolute;\r\n  bottom: 30px;\r\n  left: 60px;\r\n  display: flex;\r\n  gap: 18px;\r\n}\r\n\r\n.socials a {\r\n  color: #fff;\r\n  font-size: 22px;\r\n}\r\n\r\n\r\n\r\n\r\n/* PHONE NUMBER (hidden on desktop, visible in mobile menu) */\r\n.phone-number {\r\n  display: block;\r\n  font-size: 18px;\r\n  color: white;\r\n  /* margin-top: 20px; spacing in mobile menu */\r\n}\r\n\r\n/* Hide mobile menu on desktop */\r\n.nav-links {\r\n  display: none; /* hidden by default on desktop */\r\n}\r\n\r\n.mobile-phone{\r\n  display: none;\r\n}\r\n\r\n\r\n\r\n/* ABOUT SECTION */\r\n.about-section {\r\n  \r\n  width: 100%;\r\n  min-height: 100vh;\r\n  background: rgb(14, 14, 39);\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 60px;\r\n  color: white;\r\n}\r\n\r\n.about-wrapper {\r\n  max-width: 100%;\r\n  height: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 80px;\r\n}\r\n\r\n/* LEFT CONTENT — SAME AS HOME */\r\n.about-text {\r\n  max-width: 650px; /* EXACT SAME AS .content */\r\n}\r\n\r\n.about-text h2 {\r\n  font-size: 48px;   /* EXACT SAME SIZE AS HOME H1 */\r\n  font-weight: 700;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.about-text h2 span {\r\n  color: #00eaff;\r\n}\r\n\r\n.about-email {\r\n  font-size: 28px;\r\n  color: #00eaff;\r\n  margin-bottom: 100px;\r\n  display: block;\r\n}\r\n\r\n.about-text p {\r\n  font-size: 16px;\r\n  line-height: 1.7;\r\n  opacity: 0.9;\r\n}\r\n\r\n/* RIGHT IMAGE - ABOUT SECTION */\r\n.about-image {\r\n  display: flex;\r\n  justify-content: flex-end; /* push image to the right */\r\n  align-items: center;\r\n  flex: 1;\r\n}\r\n\r\n.about-image img {\r\n  height: 100%;       /* full height of the section */\r\n  max-width: 100%;    /* allow it to stretch naturally */\r\n  /* width: auto; */\r\n  filter: drop-shadow(0 15px 40px rgba(0,0,0,0.6));\r\n  -o-object-fit: cover;\r\n     object-fit: cover;  /* keeps aspect ratio while filling height */\r\n}\r\n\r\n\r\n\r\n\r\n\r\n/* RESPONSIVE */\r\n@media (max-width: 768px) {\r\n\r\n.nav-left {\r\n    display: none; /* hide desktop links */\r\n  }\r\n\r\n  .hamburger {\r\n    display: flex;\r\n  }\r\n\r\n  .nav-links {\r\n    display: flex; /* show mobile menu when active */\r\n    flex-direction: column;\r\n    position: fixed;\r\n    top: 0;\r\n    right: -100%;\r\n    width: 80%;\r\n    height: 100vh;\r\n    background: rgba(0,0,0,0.92);\r\n    padding-top: 140px;\r\n    gap: 30px;\r\n    align-items: center;\r\n    transition: right 0.4s ease, opacity 0.4s ease;\r\n    opacity: 0;\r\n    z-index: 200;\r\n  }\r\n\r\n  .nav-links.mobile-active {\r\n    right: 0;\r\n    opacity: 1;\r\n  }\r\n\r\n\r\n\r\n .hero {\r\n  width: 100%;\r\n  min-height: 100vh;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  text-align: center;\r\n  background-size: cover;  /* image resizes automatically */\r\n    background-position: right;\r\n}\r\n\r\n.content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n}\r\n\r\n  .content h1 {\r\n    font-size: 36px;\r\n  }\r\n\r\n  .close-btn {\r\n    background: transparent;\r\n    border: none;\r\n    font-size: 40px;\r\n    color: #fff;\r\n    position: absolute;\r\n    top: 20px;\r\n    right: 20px;\r\n    cursor: pointer;\r\n    z-index: 250;\r\n  }\r\n\r\n  /*  SOCIAL MEDIA LINKS MOBILE */\r\n\r\n    .socials {\r\n    left: 50%;\r\n    transform: translateX(-50%);\r\n  }\r\n\r\n  .phone-number{ \r\n    display: none;\r\n  }\r\n\r\n  /* MOBILE PHONE NUMBER - hidden by default */\r\n.mobile-phone {\r\n  display: none;\r\n}\r\n\r\n/* Show mobile phone only when mobile menu is active */\r\n.nav-links.mobile-active .mobile-phone {\r\n  display: block;\r\n}\r\n\r\n\r\n}\r\n\r\n/* ABOUT SECTION MOBILE */\r\n@media (max-width: 1150px) {\r\n  .about-wrapper {\r\n    flex-direction: column; /* stack vertically */\r\n    gap: 40px;\r\n  }\r\n\r\n  .about-image {\r\n    order: -1; /* put image at the top */\r\n    width: 100%; /* optional: full width */\r\n    display: flex;\r\n    justify-content: center; /* center image horizontally */\r\n  }\r\n\r\n  .about-image img {\r\n    width: 240px; /* your desired mobile size */\r\n    height: auto; \r\n    -o-object-fit: cover; \r\n       object-fit: cover;\r\n  }\r\n\r\n  .about-text {\r\n    order: 0; /* text stays below image */\r\n    align-items: center;\r\n    text-align: center;\r\n  }\r\n\r\n  .about-text h2 {\r\n    font-size: 36px;\r\n  }\r\n}\r\n`, \"\"]);\n// Exports\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n//# sourceURL=webpack://webpack-project/./src/styles.css?./node_modules/css-loader/dist/cjs.js!./node_modules/postcss-loader/dist/cjs.js\n}");

